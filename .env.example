# Copy to server/.env (local) or set as environment variables (production).

PORT=4000
NODE_ENV=development

# Optional for the demo (a random one is generated at startup, so logins reset on restart).
JWT_SECRET=

# Demo build: any email can register. To restrict, e.g. ALLOWED_EMAIL_DOMAINS=college.edu
ALLOWED_EMAIL_DOMAINS=
# These emails become admin when they register. (The very first account is always admin.)
ADMIN_EMAILS=
# false = only verified teachers/admins can create communities
ALLOW_STUDENT_COMMUNITIES=true

# SQLite database file. In Docker/EC2 keep this on a persistent volume (e.g. /data/campus.db)
DB_PATH=./data/campus.db

# ---- File storage -----------------------------------------------------------
# If S3_BUCKET is set, uploads go to AWS S3. Otherwise they are stored on local disk (dev only).
S3_BUCKET=
AWS_REGION=ap-south-1
S3_PREFIX=uploads/
MAX_UPLOAD_MB=25
S3_URL_TTL_SECONDS=300
# Credentials: run infra\setup-aws.ps1 (Windows) or infra/setup-aws.sh - it fills these in for you.
# On EC2/ECS you can instead attach an IAM role and leave the keys out.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3-compatible stores (MinIO, Cloudflare R2, LocalStack):
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Local-disk upload folder (used only when S3_BUCKET is empty)
# UPLOAD_DIR=./data/uploads
